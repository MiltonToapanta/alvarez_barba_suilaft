IA_BASE_URL=http://ia.suilaft.tech
IA_API_KEY=tu_api_key_aqui
IA_HTTP_TIMEOUT=300
IA_WEB_HTTP_TIMEOUT=55
AI_WORKER_LIMIT=1

DB_HOST=db
DB_PORT=3306
DB_NAME=suilaft_ai
DB_USER=suilaft
DB_PASSWORD=
# Laravel valida la sesión del portal (no hay login propio)
PORTAL_API_URL=http://web
DB_CHARSET=utf8mb4

# Zona horaria de la app y de la sesion MySQL.
APP_TIMEZONE=America/Guayaquil

# Proveedor principal. Si DEEPSEEK_API_KEY esta configurado, DeepSeek responde primero.
# La IA de Suilaft queda como apoyo/fallback para tareas largas o errores.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_HTTP_TIMEOUT=120
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=8192

# Agente de triaje (guardrails). auto = usa DeepSeek para clasificar mensajes dudosos
# (fuera de alcance, mixtos o con intento de manipulacion). off = solo heuristicas locales.
AI_TRIAGE_LLM=auto
AI_TRIAGE_TIMEOUT=20

# Especialista con razonamiento previo (thinking) de DeepSeek: respuestas mas analiticas.
# Si el modelo no lo admite, la app reintenta sola sin razonamiento. disabled = mas rapido.
AI_SPECIALIST_THINKING=enabled

# Memoria (compactacion): resume el historial antiguo en Markdown. Tambien con /compact.
AI_COMPACT_AFTER_MESSAGES=16
AI_COMPACT_AFTER_CHARS=40000
AI_COMPACT_KEEP_RECENT=6

# Tamano maximo de archivos para chats, proyectos y biblioteca normativa (MB).
UPLOAD_MAX_MB=15

# Tambien puedes usar este formato:
# ia.base-url=http://ia.suilaft.tech
# ia.api-key=${IA_API_KEY}
